            "group": "colourway",
            "resources": [
              {
                "type": "token",
                "path": "color.semantic.secondary"
              }
            ]
          },
          {
            "id": "surface",
            "label": "Background",
            "description": "White in the light look and Pine in the dark.",
            "group": "colourway",
            "resources": [
              {
                "type": "token",
                "path": "color.semantic.surface"
              }
            ]
          },
          {
            "id": "text",
            "label": "Text",
            "description": "Pine on light grounds and White on dark.",
            "group": "colourway",
            "resources": [
              {
                "type": "token",
                "path": "color.semantic.text"
              }
            ]
          },
          {
            "id": "warm-accent",
            "label": "Warm accent",
            "description": "Use sparingly, for emphasis and energy.",
            "group": "colourway",
            "resources": [
              {
                "type": "token",
                "path": "color.semantic.warm-accent"
              }
            ]
          }
        ],
        "bindings": [],
        "rules": [
          {
            "id": "headline-weight",
            "label": "Headlines are set in Medium (500)",
            "kind": "text-weight",
            "roleIds": [
              "typeface"
            ],
            "parameters": {
              "target": "headline",
              "weights": [
                "500"
              ]
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "required",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Typography"
            },
            "review": {
              "state": "draft"
            },
            "description": "A headline is a title-role text, or a text without a role at 5% of its artboard height or more."
          },
          {
            "id": "text-weight",
            "label": "Text runs Regular to Medium (400 to 500)",
            "kind": "text-weight",
            "roleIds": [
              "typeface"
            ],
            "parameters": {
              "target": "body",
              "weights": [
                "400",
                "500"
              ]
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "advisory",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Typography"
            },
            "review": {
              "state": "draft"
            },
            "description": "The outer weights of the variable range are for expressive display work, not everyday layouts."
          },
          {
            "id": "headline-case",
            "label": "Headlines are never all caps",
            "kind": "text-case",
            "roleIds": [
              "typeface"
            ],
            "parameters": {
              "target": "headline",
              "forbid": "upper"
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "required",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Typography"
            },
            "review": {
              "state": "draft"
            },
            "description": "Sentence case or title case, never capitals throughout."
          },
          {
            "id": "text-align",
            "label": "Text is left-aligned",
            "kind": "text-align",
            "roleIds": [
              "typeface"
            ],
            "parameters": {
              "align": "left",
              "exemptRoles": [
                "quote",
                "attribution",
                "number",
                "label"
              ],
              "exemptFurniture": [
                "page-number*"
              ],
              "exemptArchetypes": [
                "stats-*",
                "big-number*",
                "quote*"
              ],
              "exemptNumeric": true
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "advisory",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Typography"
            },
            "review": {
              "state": "draft"
            },
            "description": "Stats, big numbers, quotes, page numbers and text made only of numerals are exempt, as the slide master centres them."
          },
          {
            "id": "color-pairing",
            "label": "Text colours follow the approved combinations",
            "kind": "color-pairing",
            "roleIds": [
              "core-colours"
            ],
            "parameters": {
              "source": "token-extension",
              "key": "combinations",
              "use": "text"
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "required",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Colour combinations"
            },
            "review": {
              "state": "draft"
            },
            "description": "Read from each background token's combinations. Jungle makes a poor text colour on White or Fog. Shades outside the named colours are not covered."
          },
          {
            "id": "stroke-on-rounded",
            "label": "No accent-coloured border on a rounded shape",
            "kind": "stroke-on-rounded",
            "roleIds": [
              "hairlines"
            ],
            "parameters": {
              "shapes": [
                "rounded",
                "pill",
                "ellipse",
                "circle"
              ],
              "neutral": [
                "{color.ramp.fog.7}",
                "{color.ramp.fog.2}"
              ],
              "stripMax": 12
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "required",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Component rules 1"
            },
            "review": {
              "state": "draft"
            },
            "description": "Neither an outline nor a one-sided stripe. Carry the accent with a tinted fill; a neutral hairline is allowed for definition."
          },
          {
            "id": "dash-reserved",
            "label": "A dashed border means a drop target",
            "kind": "dash-reserved",
            "roleIds": [],
            "parameters": {
              "styles": [
                "dashed"
              ],
              "meaning": "drop-target"
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "advisory",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Component rules 2"
            },
            "review": {
              "state": "draft"
            },
            "description": "Never dashed for empty, invalid, optional or unreachable states."
          },
          {
            "id": "logo-surface",
            "label": "A positive mark on light, a negative mark on dark and photography",
            "kind": "logo-surface",
            "roleIds": [],
            "parameters": {
              "light": [
                "suse/logo/hor-pos-green",
                "suse/logo/vert-pos-green",
                "suse/logo/hor-pos-black",
                "suse/logo/vert-pos-black"
              ],
              "dark": [
                "suse/logo/hor-neg-white",
                "suse/logo/vert-neg-white",
                "suse/logo/hor-neg-green",
                "suse/logo/vert-neg-green"
              ],
              "photo": [
                "suse/logo/hor-neg-white",
                "suse/logo/vert-neg-white",
                "suse/logo/hor-neg-green",
                "suse/logo/vert-neg-green"
              ]
            },
            "scope": {
              "tools": [
                "design"
              ]
            },
            "requirement": "advisory",
            "origin": {
              "kind": "source",
              "reference": "suse-brand-skill.md",
              "locator": "Logo"
            },
            "review": {
              "state": "draft"
            },
            "description": "The guidance prefers neg-white on dark surfaces and photography; the slide master places neg-green on both, so both negative marks are accepted there. A positive mark on a dark surface or a picture, or a negative mark on a light one, is reported."
          }
        ]
      }
    }
  },
