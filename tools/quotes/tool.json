{
  "id": "quotes",
  "name": "Quotes",
  "description": "On-brand quote cards for social posts and slides.",
  "version": "1.1.2",
  "engineVersion": "^1.0.0",
  "status": "official",
  "category": "everyone",
  "tags": ["quote", "social", "marketing", "card"],
  "render": {
    "width": 1080,
    "height": 1080,
    "formats": ["png", "svg", "penpot", "html", "md", "txt", "pdf", "pdf-cmyk", "cmyk-tiff", "pptx", "webp", "avif", "jpeg", "tiff"],
    "actions": ["copy", "download", "save"],
    "transparentBg": false
  },
  "hooks": {
    "onInit": true,
    "onInput": true
  },
  "inputs": [
    {
      "id": "theme",
      "label": "Theme",
      "type": "select",
      "default": "dark",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark",  "label": "Dark" },
        { "value": "main",  "label": "Main" }
      ]
    },
    {
      "id": "quoteStyle",
      "label": "Quote style",
      "type": "select",
      "default": "big",
      "options": [
        { "value": "big",      "label": "Big quote mark" },
        { "value": "wrapping", "label": "Wrapping quotes" },
        { "value": "none",     "label": "No quotes" }
      ]
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "select",
      "default": "minimal",
      "options": [
        { "value": "minimal",      "label": "Minimal" },
        { "value": "speaker-top",  "label": "Speaker on top" },
        { "value": "side-by-side", "label": "Side by side" }
      ]
    },
    {
      "id": "frameInset",
      "display": "slider",
      "label": "Frame inset",
      "type": "number",
      "default": 80,
      "min": 0,
      "max": 400,
      "step": 1,
      "help": "Padding in pixels between the card edge and its content."
    },
    {
      "id": "separator",
      "label": "Separator",
      "type": "boolean",
      "default": true,
      "help": "Show a divider line between the quote and the speaker."
    },
    {
      "id": "ambientMotion",
      "label": "Ambient motion",
      "type": "boolean",
      "default": false,
      "help": "A slow drifting glow behind the quote while you work. Off keeps the exported card a clean still."
    },
    {
      "id": "quote",
      "label": "Quote",
      "type": "longtext",
      "required": true,
      "default": "The best way to predict the future is to create it.",
      "rows": 4,
      "help": "The quote text to display. Supports **bold**, *italic* and ~~strikethrough~~ markdown."
    },
    {
      "id": "weight",
      "label": "Quote weight",
      "type": "number",
      "display": "slider",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 300,
      "help": "Font weight of the quote text (100 Thin to 900 Black). Bold **markdown** stays bold."
    },
    {
      "id": "name",
      "label": "Name",
      "type": "text",
      "default": "",
      "help": "Who said the quote. With no name, the company is hidden too."
    },
    {
      "id": "company",
      "label": "Company",
      "type": "text",
      "default": "",
      "help": "Job title or company, shown under the name."
    },
    {
      "id": "headshot",
      "label": "Headshot",
      "type": "asset",
      "assetType": "raster",
      "allowUpload": true,
      "help": "Optional portrait photo. Upload your own or choose from the library."
    },
    {
      "id": "bgImage",
      "label": "Background image",
      "section": "Background",
      "type": "asset",
      "assetType": "raster",
      "allowUpload": true,
      "help": "Optional background image behind the quote."
    },
    {
      "id": "bgOpacity",
      "label": "Opacity",
      "section": "Background",
      "type": "number",
      "display": "slider",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.5
    },
    {
      "id": "imageFraming",
      "label": "Zoom & position",
      "section": "Background",
      "framingFor": "bgImage",
      "help": "Drag the image on the canvas to move it, scroll to zoom, and hold Alt while dragging to straighten converging verticals. Or drag a label / type a value here.",
      "type": "vector",
      "fields": [
        { "id": "zoom",   "label": "Zoom",       "min": 100,  "max": 400, "step": 1,   "default": 100 },
        { "id": "x",      "label": "X",          "min": 0,    "max": 100, "step": 1,   "default": 50  },
        { "id": "y",      "label": "Y",          "min": 0,    "max": 100, "step": 1,   "default": 50  },
        { "id": "rotate", "label": "Rotate",     "min": -180, "max": 180, "step": 0.5, "default": 0   },
        { "id": "pitch",  "label": "Vertical",   "min": -45,  "max": 45,  "step": 0.5, "default": 0   },
        { "id": "yaw",    "label": "Horizontal", "min": -45,  "max": 45,  "step": 0.5, "default": 0   }
      ]
    },
    {
      "id": "imageFit",
      "label": "Fit",
      "section": "Background",
      "type": "select",
      "attachTo": "bgImage",
      "display": "icon-toggle",
      "default": "cover",
      "options": [
        { "value": "cover",   "label": "Fill", "icon": "fitCover" },
        { "value": "contain", "label": "Fit",  "icon": "fitContain" }
      ]
    },
    {
      "id": "headshotFraming",
      "label": "Headshot framing",
      "framingFor": "headshot",
      "help": "Move and zoom the portrait inside its circle - drag it on the canvas, or set the numbers here.",
      "type": "vector",
      "fields": [
        { "id": "zoom",   "label": "Zoom",   "min": 100,  "max": 400, "step": 1,   "default": 100 },
        { "id": "x",      "label": "X",      "min": 0,    "max": 100, "step": 1,   "default": 50  },
        { "id": "y",      "label": "Y",      "min": 0,    "max": 100, "step": 1,   "default": 50  },
        { "id": "rotate", "label": "Rotate", "min": -180, "max": 180, "step": 0.5, "default": 0   }
      ]
    }
  ]
}
