{
  "id": "pose-geeko",
  "name": "Pose Geeko",
  "description": "Pose the SUSE Geeko with sliders - eyes, blink and limbs - as a print-ready still, or bring it to life as a looping scene where it looks around, blinks and sways on its branch.",
  "version": "0.2.0",
  "engineVersion": "^1.0.0",
  "status": "official",
  "category": "designer",
  "new": true,
  "tags": ["geeko", "mascot", "pose", "illustration", "svg"],
  "hooks": { "onInit": true, "onInput": true, "beforeExport": true },
  "render": {
    "width": 800,
    "height": 800,
    "formats": ["svg", "penpot", "png", "webp", "avif", "pdf", "dxf", "cmyk-tiff", "jpg", "tiff", "emf", "eps", "pdf-cmyk", "gif", "mp4", "webm"],
    "video": { "wait": 0, "duration": 8 },
    "actions": ["download", "copy", "save"]
  },
  "featured": {
    "order": 2,
    "blurb": "Pose the SUSE Geeko - print-ready stills or a living loop",
    "variants": [
      {
        "label": "Curious climb · transparent",
        "values": {
          "pose": "curious",
          "foliage": 26,
          "eyeX": -34,
          "eyeY": -18,
          "headTilt": 7,
          "blink": 0,
          "bg": "transparent",
          "geeko": { "scale": 1.06, "x": -5, "y": 3 }
        }
      },
      {
        "label": "Sitting · on dark",
        "values": {
          "pose": "sitting",
          "tail": -18,
          "blink": 8,
          "eyeX": 46,
          "eyeY": 8,
          "headTilt": -5,
          "bg": "dark",
          "geeko": { "scale": 0.9, "x": 2, "y": 10 }
        }
      },
      {
        "label": "Dangling · flipped",
        "values": {
          "pose": "dangling",
          "legFront": 58,
          "legBack": -28,
          "headTilt": -9,
          "flip": true,
          "eyeX": 70,
          "eyeY": -12,
          "bg": "light",
          "geeko": { "scale": 1.28, "x": 9, "y": -7 }
        }
      },
      {
        "label": "Laying · light",
        "values": {
          "pose": "laying",
          "blink": 66,
          "headTilt": 12,
          "eyeY": 40,
          "bg": "light",
          "geeko": { "scale": 0.82, "x": 0, "y": 17 }
        }
      },
      {
        "label": "Sitting · transparent",
        "values": {
          "pose": "sitting",
          "tail": 3,
          "eyeX": 92,
          "eyeY": -12,
          "blink": 0,
          "bg": "transparent",
          "geeko": { "scale": 1, "x": 0, "y": 0 }
        }
      },
      {
        "label": "Alive loop · on pine",
        "values": {
          "pose": "curious",
          "motion": "alive",
          "loop": 8,
          "energy": 60,
          "eyeX": 10,
          "eyeY": -5,
          "bg": "pine",
          "geeko": { "scale": 1.04, "x": -3, "y": 4 }
        }
      }
    ]
  },
  "inputs": [
    {
      "id": "pose",
      "label": "Pose",
      "type": "select",
      "default": "curious",
      "options": [
        { "value": "curious",   "label": "Curious" },
        { "value": "sitting",   "label": "Sitting" },
        { "value": "laying",    "label": "Laying" },
        { "value": "dangling",  "label": "Dangling" }
      ]
    },
    {
      "id": "eyeX",
      "label": "Eye left / right",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Slides the pupil across the eye. Positive looks right.",
      "min": -100,
      "max": 200,
      "step": 1,
      "default": 0
    },
    {
      "id": "eyeY",
      "label": "Eye up / down",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Slides the pupil across the eye. Positive looks down.",
      "min": -100,
      "max": 200,
      "step": 1,
      "default": 0
    },
    {
      "id": "blink",
      "label": "Blink",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Zero is wide awake; higher closes the eyes.",
      "min": 0,
      "max": 300,
      "step": 1,
      "default": 0,
      "showIf": { "pose": ["curious", "sitting", "laying"] },
      "rangeWhen": [
        { "when": { "pose": "curious" }, "min": 0, "max": 100 },
        { "when": { "pose": "sitting" }, "min": 0, "max": 100 }
      ]
    },
    {
      "id": "headTilt",
      "label": "Head tilt",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Tilts the Geeko's head.",
      "min": -30,
      "max": 30,
      "step": 1,
      "default": 0,
      "rangeWhen": [
        { "when": { "pose": "laying" },   "min": -14, "max": 18 },
        { "when": { "pose": "dangling" }, "min": -14, "max": 9 }
      ]
    },
    {
      "id": "foliage",
      "label": "Leaves and branch",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Rotates the branch and leaves. Curious pose.",
      "min": -40,
      "max": 40,
      "step": 1,
      "default": 0,
      "showIf": { "pose": "curious" }
    },
    {
      "id": "legFront",
      "label": "Front leg",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Swings the front leg. Dangling pose.",
      "min": -30,
      "max": 80,
      "step": 1,
      "default": 0,
      "showIf": { "pose": "dangling" }
    },
    {
      "id": "legBack",
      "label": "Back leg",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Swings the back leg. Dangling pose.",
      "min": -45,
      "max": 45,
      "step": 1,
      "default": 0,
      "showIf": { "pose": "dangling" }
    },
    {
      "id": "tail",
      "label": "Tail curl",
      "type": "number",
      "display": "slider",
      "section": "Fine tuning",
      "help": "Curls the tail. Sitting pose.",
      "min": -22,
      "max": 10,
      "step": 1,
      "default": 0,
      "showIf": { "pose": "sitting" }
    },
    {
      "id": "geeko",
      "label": "Scale and position",
      "section": "Geeko options",
      "help": "Scale sizes Geeko; X / Y nudge it in the frame (%). Drag a label or type a value.",
      "type": "vector",
      "fields": [
        { "id": "scale", "label": "Scale", "min": 0.25, "max": 3,   "step": 0.05, "default": 1 },
        { "id": "x",     "label": "X",     "min": -100, "max": 100, "step": 1,    "default": 0 },
        { "id": "y",     "label": "Y",     "min": -100, "max": 100, "step": 1,    "default": 0 }
      ]
    },
    {
      "id": "flip",
      "label": "Flip Geeko",
      "type": "boolean",
      "section": "Geeko options",
      "default": false
    },
    {
      "id": "motion",
      "label": "Motion",
      "type": "select",
      "section": "Motion",
      "default": "still",
      "help": "Alive plays a loop on top of your pose: the Geeko looks around, blinks and breathes, and its branch and leaves sway. Still and print exports keep the pose exactly; an SVG export, a video and a Design box carry the loop.",
      "options": [
        { "value": "still", "label": "Still" },
        { "value": "alive", "label": "Alive (looping)" }
      ]
    },
    {
      "id": "loop",
      "label": "Loop length",
      "type": "number",
      "display": "slider",
      "section": "Motion",
      "help": "Seconds for one full cycle. The loop ends exactly where it began, so a video of this length, or any multiple of that length, repeats without a jump.",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8,
      "showIf": { "motion": "alive" }
    },
    {
      "id": "energy",
      "label": "Liveliness",
      "type": "number",
      "display": "slider",
      "section": "Motion",
      "help": "How much everything moves, from a calm glance to a lively look-around on a windy branch.",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 60,
      "showIf": { "motion": "alive" }
    },
    {
      "id": "idle",
      "label": "Idle motion",
      "help": "A gentle on-screen breath for the still pose. Turn off for a dead-still preview. Never part of an export.",
      "type": "boolean",
      "section": "Motion",
      "default": true,
      "showIf": { "motion": "still" }
    },
    {
      "id": "bg",
      "label": "Background",
      "type": "select",
      "section": "Geeko options",
      "default": "transparent",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "dark",   "label": "Dark" },
        { "value": "light",  "label": "Light" },
        { "value": "pine",   "label": "Pine" }
      ]
    }
  ]
}
