      "type": "boolean",
      "display": "pill",
      "default": false,
      "section": "Text and type",
      "showIf": {
        "typeControls": true
      },
      "help": "Customise | pipe | tables |."
    },
    {
      "id": "h1Size",
      "label": "Heading 1 size",
      "type": "number",
      "display": "slider",
      "section": "Text and type",
      "min": 25,
      "max": 300,
      "step": 5,
      "default": 100,
      "showIf": {
        "typeControls": true,
        "h1On": true
      },
      "help": "Percent of the built-in size (100 = as authored). Applies to the slide title and any # heading."
